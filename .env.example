# Copy to .env and edit. Never commit .env.

# Where the UI listens on the host. Leave it on localhost unless there is a
# TLS reverse proxy in front.
BIND_ADDR=127.0.0.1
HTTP_PORT=8080

POSTGRES_USER=nullstar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nullstar

# Signs session cookies. Must be changed.
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Read-only GitHub token. Without one the collector gets 60 requests an hour
# instead of 5000, which is not enough. Can also be set from the admin pages.
GITHUB_TOKEN=

# Collection
SCHEDULER_ENABLED=true
ROLLING_ENABLED=true
ROLLING_INTERVAL_SECONDS=90
ROLLING_BATCH_SIZE=2
COLLECT_INTERVAL_MINUTES=60
COLLECT_LOOKBACK_DAYS=10
MAX_API_CALLS_PER_RUN=900
STREAM_POLL_SECONDS=4

# Set true once you serve over HTTPS.
COOKIE_SECURE=false

# Optional webhook for high scoring finds. Slack and Discord both work.
ALERT_WEBHOOK_URL=
ALERT_MIN_SCORE=80
